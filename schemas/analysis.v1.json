{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soota.local/schemas/analysis.v1.json",
  "title": "Soota Analysis",
  "type": "object",
  "required": ["schema_version", "summary"],
  "properties": {
    "schema_version": { "const": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "key_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "start_ms": { "type": ["integer", "null"] },
          "end_ms": { "type": ["integer", "null"] },
          "summary": { "type": "string" }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "language": { "type": ["string", "null"] }
  }
}
